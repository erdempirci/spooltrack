rules_version = '2';

// SpoolTrack Firestore security rules.
// Roles live in users/{uid}.role: 'pending' (new sign-up, no access), 'engineer', 'admin'.
// The UI hides admin screens, but these rules are what actually enforce the roles.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return hasProfile() && role() == 'admin';
    }
    function isMember() {
      return hasProfile() && role() in ['admin', 'engineer'];
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Self sign-up may only create a 'pending' profile. Admins approve.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'createdAt']);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && onlyChanges(['name']));
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();

      match /spools/{spoolId} {
        allow read: if isMember();
        allow create, delete: if isAdmin();
        // Production engineers can only change the status of an existing spool.
        allow update: if isAdmin()
          || (isMember()
              && onlyChanges(['status', 'updatedAt', 'updatedBy'])
              && request.resource.data.status in ['baslamadi', 'devam', 'bitti']
              && request.resource.data.updatedBy == request.auth.uid);
      }

      match /isometrics/{id} {
        allow read: if isMember();
        allow write: if isAdmin();
      }
      match /materials/{id} {
        allow read: if isMember();
        allow write: if isAdmin();
      }
      match /spoolMaterials/{id} {
        allow read: if isMember();
        allow write: if isAdmin();
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
